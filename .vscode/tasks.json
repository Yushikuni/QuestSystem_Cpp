{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe sestavit aktivní soubor",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/*.cpp", // Zkompiluje všechny .cpp soubory v kořenu projektu
                "-o",
                "${workspaceFolder}\\Test_01.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Úloha vygenerovaná ladicím programem"
        }
    ],
    "version": "2.0.0"
}